+
+static void test_verify_unsorted_authenticated_attributes(void)
+{
+    HCRYPTMSG msg;
+    PCCERT_CONTEXT cert;
+    BYTE *certBlob;
+    DWORD size;
+    BOOL ret;
+
+    msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
+    ok(msg != NULL, "CryptMsgOpenToDecode failed: %08lx\n", GetLastError());
+
+    ret = CryptMsgUpdate(msg, msgWithUnsortedAuthAttrs,
+     sizeof(msgWithUnsortedAuthAttrs), TRUE);
+    ok(ret, "CryptMsgUpdate failed: %08lx\n", GetLastError());
+
+    size = 0;
+    ret = CryptMsgGetParam(msg, CMSG_CERT_PARAM, 0, NULL, &size);
+    ok(ret, "CMSG_CERT_PARAM failed: %08lx\n", GetLastError());
+    certBlob = HeapAlloc(GetProcessHeap(), 0, size);
+    ret = CryptMsgGetParam(msg, CMSG_CERT_PARAM, 0, certBlob, &size);
+    ok(ret, "CMSG_CERT_PARAM failed: %08lx\n", GetLastError());
+
+    cert = CertCreateCertificateContext(X509_ASN_ENCODING, certBlob, size);
+    ok(cert != NULL, "CertCreateCertificateContext failed: %08lx\n",
+     GetLastError());
+
+    ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE,
+     cert->pCertInfo);
+    ok(ret, "CMSG_CTRL_VERIFY_SIGNATURE failed on a message whose "
+     "authenticated attributes are not in DER order: %08lx\n",
+     GetLastError());
+
+    CertFreeCertificateContext(cert);
+    HeapFree(GetProcessHeap(), 0, certBlob);
+    CryptMsgClose(msg);
+}
+
 START_TEST(msg)
 {
     /* Basic parameter checking tests */
@@ -3746,4 +3911,5 @@ START_TEST(msg)
 
     test_msg_get_and_verify_signer();
     test_verify_ecc_signature();
+    test_verify_unsorted_authenticated_attributes();
 }
